      "key_discussion_points",
      "action_items",
      "resolution_status",
      "sentiment_trajectory",
      "entities"
    ],
    "title": "SummaryResult",
    "type": "object"
  },
  "QAScoreResult": {
    "$defs": {
      "ComplianceFlag": {
        "properties": {
          "violation": {
            "title": "Violation",
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ],
            "title": "Severity",
            "type": "string"
          },
          "transcript_reference": {
            "title": "Transcript Reference",
            "type": "string"
          }
        },
        "required": [
          "violation",
          "severity",
          "transcript_reference"
        ],
        "title": "ComplianceFlag",
        "type": "object"
      },
      "QADimensionScore": {
        "properties": {
          "score": {
            "maximum": 5,
            "minimum": 1,
            "title": "Score",
            "type": "integer"
          },
          "justification": {
            "title": "Justification",
            "type": "string"
          }
        },
        "required": [
          "score",
          "justification"
        ],
        "title": "QADimensionScore",
        "type": "object"
      }
    },
    "properties": {
      "call_id": {
        "format": "uuid",
        "title": "Call Id",
        "type": "string"
      },
      "professionalism": {
        "$ref": "#/$defs/QADimensionScore"
      },
      "empathy": {
        "$ref": "#/$defs/QADimensionScore"
      },
      "problem_resolution": {
