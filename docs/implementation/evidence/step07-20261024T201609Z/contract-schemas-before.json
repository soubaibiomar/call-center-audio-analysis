        ],
        "title": "ResolutionStatus",
        "type": "string"
      }
    },
    "properties": {
      "call_id": {
        "format": "uuid",
        "title": "Call Id",
        "type": "string"
      },
      "call_purpose": {
        "title": "Call Purpose",
        "type": "string"
      },
      "key_discussion_points": {
        "items": {
          "type": "string"
        },
        "title": "Key Discussion Points",
        "type": "array"
      },
      "action_items": {
        "items": {
          "$ref": "#/$defs/ActionItem"
        },
        "title": "Action Items",
