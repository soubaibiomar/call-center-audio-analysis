# Copy to .env and supply your own provider key locally. Never commit .env.
# Existing provider/model defaults are preserved; Ollama is not supported upstream.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=
# Optional provider-specific model override; verify access before selecting a model.
# GROQ_MODEL=openai/gpt-oss-20b

# Keep tracing off for local preparation: upstream nodes can trace raw audio/text.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=project28-local
GRADIO_ANALYTICS_ENABLED=false

# Standard sqlite3 is used. DB_ENCRYPTION_KEY does NOT enforce encryption.
DB_PATH=data/calls.db
# PostgreSQL is opt-in; use a non-owner runtime role after Alembic upgrade/import.
# Set DATABASE_URL or DATABASE_URL_FILE privately, never both.
# DATABASE_URL_FILE=.local/step08_app_host_url

# Existing .env.example values; these differ from some code defaults.
MAX_COST_PER_CALL_USD=2.00
MAX_RETRIES_PER_NODE=3
LLM_TIMEOUT_SECONDS=30
WHISPER_MODEL_SIZE=tiny
# The existing heuristic remains the default; opt in only after provisioning the local model.
# DIARIZATION_BACKEND=pyannote
# DIARIZATION_MODEL_PATH=C:/path/to/local/community-1
CONFIDENCE_THRESHOLD=0.6
LOW_CONFIDENCE_HALT_RATIO=0.4

# Authenticated API: leave unset until a real external identity provider exists.
# OIDC_ISSUER=https://your-provider.example/issuer
# OIDC_AUDIENCE=project28-api
# OIDC_JWKS_URL=https://your-provider.example/jwks.json
# Alternative to JWKS: OIDC_PUBLIC_KEY_FILE=<administrator-managed RSA public PEM>
# OIDC_TENANT_CLAIM=tenant_id

# Durable jobs: private native config (Docker mounts its container variant).
# QUEUE_CONFIG_FILE=.local/queue_host.json

# Local cached-model inference is opt-in; hosted provider selection is preserved.
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Inside project containers: http://host.docker.internal:11434/v1
# Local calls use JSON schema, 2048 output tokens, no SDK retries/cloud fallback.
# 16 kHz VAD chunks default off except severe stereo phase cancellation; override explicitly.
# AUDIO_PREPROCESS_SEGMENTS=true
# Host-only optional decoder sandbox: immutable local Docker image with Python and PyAV.
# Requires Docker CLI/engine in the invoking environment; never falls back when configured.
# AUDIO_PROBE_CONTAINER_IMAGE=sha256:<64-character-local-image-id>
